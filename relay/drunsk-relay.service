[Unit]
Description=Drunsk relay (virtual passports, economy bridge, casino)
After=network.target mariadb.service

[Service]
Type=simple
User=drunskrelay
Group=drunskrelay
WorkingDirectory=/opt/drunsk-relay
EnvironmentFile=/etc/drunsk-relay.env
ExecStart=/usr/bin/node /opt/drunsk-relay/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/drunsk-relay

[Install]
WantedBy=multi-user.target
